<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Overlay Altitudine GPS"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Questo overlay mostra l'altitudine rilevata dal GPS in tempo reale. Puoi usarlo mentre navighi con Google Maps o altre app."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/info_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌍 Correzione geoide (livello del mare)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Il GPS mostra l'altitudine grezza WGS84, non quella sul livello del mare. Inserisci il valore di correzione per la tua zona (in Italia è circa 47)."
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edit_geoid_correction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned"
            android:hint="Es. 47.0 (Italia) oppure -60 (India)"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_correction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Salva correzione"
            android:textSize="14sp" />

    </LinearLayout>

    <CheckBox
        android:id="@+id/checkbox_show_accuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostra accuratezza GPS (±m) accanto all'altitudine"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Avvia Overlay"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Ferma Overlay"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:background="@drawable/info_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ Informazioni"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• L'overlay rimarrà sempre visibile\n• GPS attivo anche in background\n• L'accuratezza dipende dalla ricezione GPS\n• Usa il modo 'Alta Accuratezza' per migliori risultati"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5" />

    </LinearLayout>

</LinearLayout>